#!/usr/bin/make -f

UPSTREAM_GIT := https://github.com/pinterest/pymemcache.git
include /usr/share/openstack-pkg-tools/pkgos.make

%:
	dh $@ --buildsystem=pybuild --with python3

override_dh_auto_install:
	pkgos-dh_auto_install --no-py2
	touch $(CURDIR)/debian/python3-pymemcache/usr/lib/python3/dist-packages/pymemcache/py.typed

override_dh_auto_build:
	echo "Do nothing..."

override_dh_auto_clean:
	rm -rf build .stestr *.egg-info .pytest_cache .coverage coverage.xml
	find . -iname '*.pyc' -delete
	for i in $$(find . -type d -iname __pycache__) ; do rm -rf $$i ; done

override_dh_auto_test:
ifeq (,$(findstring nocheck, $(DEB_BUILD_OPTIONS)))
#	py.test-3
	set -e && for pyvers in $(PYTHON3S); do \
		python$$pyvers -m pytest -v pymemcache/test ; \
	done
endif
